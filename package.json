  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@webgpu/types": "^0.1.72",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
